# ==============================================================================
# CivicAI Backend .gitignore
# ==============================================================================

# Environment files
.env
.env.*
!.env.example

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Uploaded Files
uploads/*
!uploads/.gitkeep

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Logs & temp files
*.log
logs/
temp/
tmp/
